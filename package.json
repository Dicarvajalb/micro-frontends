{
  "name": "@my-workspace/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build:host": "vite build --config apps/fe-learning/vite.config.mts",
    "build:cotizaciones": "vite build --config apps/cotizaciones/vite.config.mts",
    "build:factura-de-venta": "vite build --config apps/factura-de-venta/vite.config.mts",
    "build:notas-de-credito": "vite build --config apps/notas-de-credito/vite.config.mts",
    "build:atoms": "vite build --config packages/atoms/vite.config.mts",
    "build:all": "npm run build:atoms && npm run build:host && npm run build:cotizaciones && npm run build:factura-de-venta && npm run build:notas-de-credito",
    "test:fe-learning": "vitest run --config apps/fe-learning/vite.config.mts apps/fe-learning/src/app/app.spec.tsx",
    "test:cotizaciones": "vitest run --config apps/cotizaciones/vite.config.mts apps/cotizaciones/src/lib/cotizaciones.spec.tsx",
    "test:factura-de-venta": "vitest run --config apps/factura-de-venta/vite.config.mts apps/factura-de-venta/src/lib/factura-de-venta.spec.tsx",
    "test:notas-de-credito": "vitest run --config apps/notas-de-credito/vite.config.mts apps/notas-de-credito/src/lib/notas-de-credito.spec.tsx",
    "test:all": "npm run test:fe-learning && npm run test:cotizaciones && npm run test:factura-de-venta && npm run test:notas-de-credito",
    "dev": "npx nx run-many --target=serve --projects=fe-learning,cotizaciones,factura-de-venta,notas-de-credito --parallel --output-style=stream"
  },
  "private": true,
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.3",
    "single-spa": "^6.0.3",
    "single-spa-react": "^6.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@nx/devkit": "22.6.4",
    "@nx/eslint": "22.6.4",
    "@nx/eslint-plugin": "22.6.4",
    "@nx/js": "22.6.4",
    "@nx/playwright": "22.6.4",
    "@nx/react": "22.6.4",
    "@nx/vite": "22.6.4",
    "@nx/vitest": "22.6.4",
    "@nx/web": "22.6.4",
    "@nx/workspace": "22.6.4",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "ajv": "^8.0.0",
    "autoprefixer": "10.4.13",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "22.6.4",
    "postcss": "8.4.38",
    "prettier": "~3.6.2",
    "tailwindcss": "3.4.3",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "~4.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
